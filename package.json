{
  "name": "simnv-drawiomap-panel",
  "version": "1.5.2",
  "scripts": {
    "build": "./scripts/vendor-drawio.sh --if-missing && webpack -c ./webpack.config.ts --env production",
    "dev": "./scripts/vendor-drawio.sh --if-missing && webpack -w -c ./webpack.config.ts --env development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:affected": "vitest run --changed main --maxWorkers=4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache . && npm run format:check && npm run check:imports",
    "format:check": "prettier --check --cache --log-level warn .",
    "lint:fix": "eslint --cache --fix . && prettier --write --list-different .",
    "check:imports": "vitest run src/importCycles.test.ts src/viewChunk.test.ts --maxWorkers=2",
    "check:privacy": "sh .githooks/check-denylist.sh --all",
    "test:hooks": "sh .githooks/test-denylist.sh",
    "hooks:install": "git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs",
    "e2e": "playwright test",
    "e2e:12.3": "./scripts/run-e2e.sh 3011 --project=matrix",
    "e2e:12": "./scripts/run-e2e.sh 3012 --project=matrix",
    "e2e:13": "./scripts/run-e2e.sh 3013 --project=matrix --project=plugin",
    "e2e:matrix": "npm run e2e:12.3 && npm run e2e:12 && npm run e2e:13",
    "e2e:webkit": "PW_WEBKIT=1 ./scripts/run-e2e.sh 3013 --project=webkit tests/card-tooltip.spec.ts",
    "e2e:release": "npm run e2e:12.3 && ./scripts/run-e2e.sh 3012 --project=matrix --project=plugin && npm run e2e:13 && npm run e2e:webkit",
    "docs:screenshots": "PW_DOCS=1 GRAFANA_URL=${GRAFANA_URL:-http://localhost:3013} playwright test --project=docs --workers=1 && ./scripts/docs-hero-gif.sh",
    "build:dashboard": "tsx scripts/build-dashboard.ts",
    "check:bundle": "./scripts/check-bundle.sh",
    "package": "./scripts/package.sh",
    "stack:up": "docker compose up -d --force-recreate --wait",
    "stack:down": "docker compose down -v",
    "stack:smoke": "./scripts/stack-smoke.sh",
    "stack:wait": "./scripts/wait-stack.sh",
    "ci:local": "./scripts/ci-local.sh",
    "ci:woodpecker": "./scripts/ci-woodpecker.sh",
    "ci:status": "./scripts/ci-status.sh",
    "sign": "sign-plugin"
  },
  "author": "Simnv",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^4.0.0",
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.1.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^65.4.4",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "imports-loader": "^5.0.0",
    "jsdom": "31.0.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.108.0",
    "sass-loader": "^17.1.0",
    "semver": "^7.8.6",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=24.5"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.4.14",
    "@grafana/i18n": "12.4.14",
    "@grafana/runtime": "12.4.14",
    "@grafana/schema": "12.4.14",
    "@grafana/ui": "12.4.14",
    "dompurify": "3.4.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.9.1"
  },
  "packageManager": "npm@11.20.0",
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
