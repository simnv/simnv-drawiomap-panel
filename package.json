{
  "name": "simnv-drawiomap-panel",
  "version": "1.0.0",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "e2e:12": "GRAFANA_URL=http://localhost:3012 playwright test",
    "e2e:13": "GRAFANA_URL=http://localhost:3013 playwright test",
    "e2e:matrix": "npm run e2e:12 && npm run e2e:13",
    "build:dashboard": "tsx scripts/build-dashboard.ts",
    "check:bundle": "./scripts/check-bundle.sh",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down -v",
    "stack:smoke": "./scripts/stack-smoke.sh",
    "sign": "sign-plugin"
  },
  "author": "Simnv",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.15.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@testing-library/react": "16.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^52.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jsdom": "26.1.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "tsx": "4.19.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "webpack": "^5.106.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "12.4.13",
    "@grafana/i18n": "12.4.13",
    "@grafana/runtime": "12.4.13",
    "@grafana/schema": "12.4.13",
    "@grafana/ui": "12.4.13",
    "dompurify": "3.2.6",
    "js-yaml": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "packageManager": "npm@11.20.0"
}
