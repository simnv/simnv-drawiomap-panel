{
  "uid": "drawiomap-demo",
  "title": "draw.io map demo",
  "tags": ["drawiomap"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "simnv-drawiomap-panel",
      "title": "demo-lab L3",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_transmit_bytes_total[1m]) * 8", "legendFormat": "{{job}} {{device}}" },
        { "refId": "C", "expr": "up", "legendFormat": "{{job}}" },
        { "refId": "D", "expr": "node_load1", "legendFormat": "{{job}}" },
        { "refId": "E", "expr": "node_cpu_usage_percent", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 }] },
          "links": [{ "title": "Field link", "url": "/explore?left=${__url_time_range}", "targetBlank": true }]
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "down", "index": 0 }, "1": { "text": "up", "index": 1 } } }] }
            ]
          },
          { "matcher": { "id": "byFrameRefID", "options": "D" }, "properties": [{ "id": "unit", "value": "none" }, { "id": "decimals", "value": 2 }] }
        ]
      },
      "options": {
        "editorUrl": "",
        "zoom": { "mode": "fit", "percent": 100, "wheel": false, "pan": false },
        "linkWidth": { "min": 2, "max": 10 },
        "rules": [],
        "diagram": null
      }
    },
    {
      "id": 2,
      "type": "simnv-drawiomap-panel",
      "title": "hand-drawn",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "rate(node_network_transmit_bytes_total[1m]) * 8", "legendFormat": "{{job}} {{device}}" }],
      "fieldConfig": { "defaults": { "unit": "bps", "decimals": 1 }, "overrides": [] },
      "options": {
        "editorUrl": "",
        "zoom": { "mode": "fit", "percent": 100, "wheel": false, "pan": false },
        "linkWidth": { "min": 2, "max": 10 },
        "rules": [],
        "diagram": null
      }
    }
  ]
}
