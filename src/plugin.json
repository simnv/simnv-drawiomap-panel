{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "draw.io map",
  "id": "simnv-drawiomap-panel",
  "info": {
    "keywords": ["panel", "drawio", "weathermap", "network", "diagram"],
    "description": "Shows a draw.io diagram as a network weathermap. Links and shapes follow the panel queries.",
    "author": {
      "name": "simnv"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      { "name": "Map with link colours", "path": "img/screenshots/map.png" },
      { "name": "Hover card", "path": "img/screenshots/hover-card.png" },
      { "name": "draw.io editor", "path": "img/screenshots/editor.png" },
      { "name": "Hover card opening", "path": "img/screenshots/hero.gif" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
